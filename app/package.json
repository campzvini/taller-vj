{
  "name": "taller-vj-app",
  "version": "1.0.0",
  "description": "Babel VJ — mesa de vídeo ao vivo, um software Taller",
  "author": "Vinicius Campos",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5273 && electron . --dev\"",
    "selftest": "npm run build && electron . --selftest",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "art.taller.babelvj",
    "productName": "Babel VJ",
    "copyright": "Taller Laboratório Fotoquímico 2026",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**/*", "dist/**/*", "build/icon-256.png", "package.json"],
    "asarUnpack": ["**/node_modules/ffmpeg-static/**", "**/node_modules/ffprobe-static/**"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Babel VJ",
      "artifactName": "BabelVJ-${version}-setup.${ext}"
    },
    "portable": { "artifactName": "BabelVJ-${version}-portable.${ext}" }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  }
}
